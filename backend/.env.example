# Copy to .env (ignored by Git). Load explicitly with node --env-file=.env.
# disabled is safe for initial deployment; fixture is ONLY for local tests.
MOTO_PROVIDER=disabled
AMAP_WEB_SERVICE_KEY=
PORT=8787
WEB_ORIGIN=http://127.0.0.1:4173

# === 后台管理接口 ===
# warm-cache 等管理端点的鉴权 token。
# 客户端必须通过 X-Admin-Token 头传入。留空 = 关闭所有 admin 端点。
MOTO_ADMIN_TOKEN=替换为长随机字符串
